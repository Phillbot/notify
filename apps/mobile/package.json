{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "android:emulator": "$HOME/Library/Android/sdk/emulator/emulator -avd Medium_Phone_API_36.1 -netdelay none -netspeed full",
    "android:with-emulator": "pnpm run android:emulator & sleep 15 && expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "android:build": "expo run:android",
    "ios:build": "expo run:ios",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:web": "expo export:web",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:mobile",
    "core": "workspace:*",
    "expo": "catalog:mobile",
    "expo-modules-core": "catalog:mobile",
    "expo-status-bar": "catalog:mobile",
    "expo-system-ui": "catalog:mobile",
    "expo-constants": "catalog:default",
    "inversify": "catalog:",
    "inversify-react": "catalog:",
    "mobx": "catalog:",
    "mobx-react": "catalog:",
    "mobx-react-lite": "catalog:",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "react-native": "catalog:mobile",
    "react-native-web": "catalog:mobile",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@types/react": "catalog:react18",
    "babel-plugin-module-resolver": "^5.0.2",
    "@babel/plugin-transform-typescript": "catalog:",
    "babel-plugin-transform-typescript-metadata": "catalog:",
    "babel-preset-expo": "catalog:mobile"
  }
}