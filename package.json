{
  "name": "notify",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "0.0.1",
  "scripts": {
    "web:dev": "nx dev web",
    "web:dev:host": "nx run web:dev:host",
    "web:build": "nx build web",
    "web:lint": "nx lint web",
    "web:clean": "nx clean:types web",
    "mobile:dev": "nx dev mobile",
    "mobile:android": "nx android mobile",
    "mobile:android:emulator": "nx android:emulator mobile",
    "mobile:android:with-emulator": "nx android:with-emulator mobile",
    "mobile:ios": "nx ios mobile",
    "mobile:clean": "nx clean:types mobile",
    "mobile:build:android": "nx build:android mobile",
    "mobile:build:ios": "nx build:ios mobile",
    "mobile:build:web": "nx build:web mobile",
    "desktop:dev": "nx dev desktop",
    "desktop:build:mac": "nx build:mac desktop",
    "desktop:build:win": "nx build:win desktop",
    "desktop:build:linux": "nx build:linux desktop",
    "server:dev": "nx dev server",
    "server:build": "nx build server",
    "server:start": "nx start server",
    "nx:reset": "nx reset",
    "clean:all": "pnpm clean:modules && pnpm clean:builds && pnpm clean:cache",
    "clean:modules": "find . -type d -name \"node_modules\" -prune -exec rm -rf {} +",
    "clean:builds": "find . -type d \\( -name \"dist\" -o -name \"release\" -o -name \"public\" -o -name \".expo\" -o -name \".next\" \\) -prune -exec rm -rf '{}' +",
    "clean:cache": "nx reset && find . -type d -name \".vite\" -prune -exec rm -rf {} +",
    "fix": "nx run-many -t lint",
    "nx": "nx",
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test --coverage",
    "test:ui": "vitest --ui",
    "graph": "nx graph",
    "infra:up": "sudo docker compose up -d",
    "infra:down": "sudo docker compose down",
    "services": "pnpm infra:up",
    "format": "prettier --write \".\"",
    "check": "pnpm run format && pnpm run lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "unplugin-swc": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "nx",
      "esbuild",
      "@swc/core"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  }
}